# Copy to .env for local overrides (prefix PLATFORM2_).
PLATFORM2_DATABASE_URL=postgresql+psycopg://platform2@127.0.0.1:5432/platform2
PLATFORM2_HARNESS_BASE_URL=http://127.0.0.1:3081
PLATFORM2_DIFY_BASE_URL=http://127.0.0.1:5001
PLATFORM2_SERVICE_TOKEN=platform2-dify-local
PLATFORM2_USE_MOCK_AI=false
PLATFORM2_USE_MOCK_DETECTION=true
# Optional SQLite fallback:
# PLATFORM2_DATABASE_URL=sqlite:///./platform2.db